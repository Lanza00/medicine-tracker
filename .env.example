# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. NEVER prefix with NEXT_PUBLIC_. All DB access goes through the server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (run: npm run gen-vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret used by the cron job that triggers reminders
CRON_SECRET=change-me-to-a-long-random-string

# Display timezone
NEXT_PUBLIC_TZ=Asia/Kuala_Lumpur
